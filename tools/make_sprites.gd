func _initialize() -> void:
	for path: String in SPRITES:
		var palette: Dictionary = SPRITES[path][0]
		var rows: Array = SPRITES[path][1]
		var image := Image.create_empty(rows[0].length(), rows.size(), false, Image.FORMAT_RGBA8)
		for y in rows.size():
			if rows[y].length() != image.get_width():
				push_error("%s: row %d is %d pixels wide, expected %d" % [path, y, rows[y].length(), image.get_width()])
				quit(1)
				return
			for x in image.get_width():
				var pixel: String = rows[y][x]
				if pixel != ".":
					image.set_pixel(x, y, palette[pixel])
		image.save_png("res://" + path)
		print("wrote ", path)
	quit()
